<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="Buntly.Windows.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <fluent:FluentTheme />
    <Style Selector="Window.buntly">
      <Setter Property="Background" Value="#111113"/>
      <Setter Property="Foreground" Value="#F4F4F5"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#C3A2F5"/>
      <Setter Property="Foreground" Value="#16141C"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
  </Application.Styles>
</Application>
